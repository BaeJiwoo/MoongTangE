{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "MOONGTANGE_BUILD_CLIENT": "ON",
        "MOONGTANGE_BUILD_NETWORK": "ON"
      }
    },
    {
      "name": "browse",
      "displayName": "MoongTangE",
      "description": "Provide project and dependency headers for C++ code navigation.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "MOONGTANGE_BUILD_CLIENT": "ON",
        "MOONGTANGE_BUILD_NETWORK": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "release-base",
      "displayName": "Windows Release (Standalone Asio / IOCP)",
      "description": "Build and test the preserved Standalone Asio variant on Windows IOCP.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "MOONGTANGE_STANDALONE_ASIO_BACKEND": "IOCP"
      }
    },
    {
      "name": "linux-release",
      "inherits": "release-base",
      "displayName": "Linux Release (Standalone Asio / epoll)",
      "description": "Build and test the preserved Standalone Asio variant on Linux epoll.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MOONGTANGE_STANDALONE_ASIO_BACKEND": "EPOLL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "jobs": 2,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 2,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ]
}
